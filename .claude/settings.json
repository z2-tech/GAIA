{
  "permissions": {
    "allow": ["mcp__codegraph-gaia-api", "mcp__codegraph-gaia-web"]
  },
  "extraKnownMarketplaces": { "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } } },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date +%H:%M)] GAIA · $(git branch --show-current)\""
          },
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR}/gaia-web/node_modules\" ] || (cd \"${CLAUDE_PROJECT_DIR}/gaia-web\" && bun install)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(gaia-web/**)",
            "command": "\"${CLAUDE_PROJECT_DIR}/gaia-web/.claude/hooks/block-generated.sh\""
          },
          {
            "type": "command",
            "if": "Write(gaia-web/**)",
            "command": "\"${CLAUDE_PROJECT_DIR}/gaia-web/.claude/hooks/block-generated.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(gaia-web/**)",
            "command": "cd \"${CLAUDE_PROJECT_DIR}/gaia-web\" && .claude/hooks/biome-fix.sh"
          },
          {
            "type": "command",
            "if": "Write(gaia-web/**)",
            "command": "cd \"${CLAUDE_PROJECT_DIR}/gaia-web\" && .claude/hooks/biome-fix.sh"
          },
          {
            "type": "command",
            "if": "Edit(gaia-web/**)",
            "command": "cd \"${CLAUDE_PROJECT_DIR}/gaia-web\" && .claude/hooks/typecheck.sh",
            "async": true
          },
          {
            "type": "command",
            "if": "Write(gaia-web/**)",
            "command": "cd \"${CLAUDE_PROJECT_DIR}/gaia-web\" && .claude/hooks/typecheck.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'QA gate: run tests + lint before PR'"
          }
        ]
      }
    ]
  }
}
