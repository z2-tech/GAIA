{
  "mcpServers": {
    "codegraph-gaia-api": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp", "--path", "gaia-api"]
    },
    "codegraph-gaia-web": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp", "--path", "gaia-web"]
    },
    "postgres-readonly": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "./.opencode/bin/postgres-mcp-readonly.sh"
      ]
    },
    "plane": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "./.opencode/bin/plane-mcp.sh"
      ]
    }
  }
}
