# =============================================================================
# ATYHA MCP Credentials Template — .env.mcp.local.example
# =============================================================================
# Copy to .env.mcp.local and fill with real credentials.
# .env.mcp.local is gitignored — never commit real secrets.
# =============================================================================

# --------------------------------------------------
# 1. Primary Database (PostgreSQL)
#    Used by: postgres MCP read-only server
#    Access mode: read-only
# --------------------------------------------------
DB_HOST=""
DB_PORT="5432"
DB_NAME=""
DB_USERNAME=""
DB_PASSWORD=""

# --------------------------------------------------
# 2. Redis / Celery Broker
# --------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# --------------------------------------------------
# 3. Object Storage (S3-compatible)
# --------------------------------------------------
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT_URL=""
