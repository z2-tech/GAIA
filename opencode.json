{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git -C * commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git -C * push *", "effect": "ask" },
    { "action": "shell", "resource": "git merge *", "effect": "ask" },
    { "action": "shell", "resource": "git -C * merge *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git -C * rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git -C * reset --hard*", "effect": "ask" }
  ],
  "experimental": {
    "subagent_depth": 2,
    "todo": true
  },
  "mcp": {
    "timeout": {
      "startup": 90000
    },
    "servers": {
      "codegraph": {
        "type": "local",
        "command": ["bash", ".opencode/bin/codegraph-mcp.sh"]
      },
      "postgres": {
        "type": "local",
        "command": ["bash", ".opencode/bin/postgres-mcp-readonly.sh"]
      },
      "plane": {
        "type": "local",
        "command": ["bash", ".opencode/bin/plane-mcp.sh"]
      }
    }
  }
}
