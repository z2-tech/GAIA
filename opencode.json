{
  "$schema": "https://opencode.ai/config.json",
  "username": "fefo",
  "model": "opencode-go/deepseek-v4-pro",
  "shell": "/bin/zsh",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["bash", ".opencode/bin/codegraph-mcp.sh"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": ["bash", ".opencode/bin/postgres-mcp-readonly.sh"],
      "enabled": true
    },
    "plane": {
      "type": "local",
      "command": ["bash", ".opencode/bin/plane-mcp.sh"],
      "enabled": true
    }
  }
}
