{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date +%H:%M)] GAIA · $(git branch --show-current)\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'QA gate: run tests + lint before PR'"
          }
        ]
      }
    ]
  }
}
